APP_NAME="SL Logistics Attendance"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://podopo.com

DB_CONNECTION=mysql
DB_HOST=your-hostinger-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-username
DB_PASSWORD=replace-with-database-password

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=your-hostinger-mailbox@your-domain.com
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_FROM_ADDRESS=your-hostinger-mailbox@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"
